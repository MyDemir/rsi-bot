# Yerelde çalıştırmak için bu dosyayı .env olarak kopyala. Fly'da bunlar `fly secrets set` ile verilir.

# ── Zorunlu ──
# @BotFather'dan alınan token
TELEGRAM_BOT_TOKEN=
# Grup ID'si (-100… ile başlar)
TELEGRAM_CHAT_ID=

# ── İsteğe bağlı ──
# Konulu grupta sinyallerin gideceği konu ID'si
TELEGRAM_THREAD_ID=
# Ayarları değiştirebilecek kullanıcı ID'leri (virgüllü); boşsa grubun yöneticileri
TELEGRAM_ADMIN_IDS=
# Gerekmez (herkese açık veri); tanımlıysa isteklerle gönderilir
BINANCE_API_KEY=
# Ayar dosyasının klasörü
DATA_DIR=./data
# Mesajlardaki saat dilimi
DISPLAY_TZ=Europe/Istanbul

# ── İzleme paneli (isteğe bağlı) ──
# scalp-bot panelinin nabız adresi, ör. https://scalp-bot.fly.dev/api/external-bots/heartbeat
HUB_URL=
# Paneldeki EXTERNAL_BOT_KEY değeri (en az 16 karakter)
HUB_KEY=
# Panelde botun kimliği ve adı (birden çok müşteri botu için farklı ver)
HUB_BOT_ID=rsi-bot
HUB_BOT_NAME=RSI Botu
